{
  "name": "@bifurcation/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-admin.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:init": "tsx --conditions=react-server scripts/admin.ts init",
    "admin:recover": "tsx --conditions=react-server scripts/admin.ts recover",
    "build:admin": "node scripts/build-admin.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bifurcation/rpc": "workspace:*",
    "@bufbuild/protobuf": "2.15.0",
    "@cloudflare/kumo": "2.13.2",
    "@connectrpc/connect": "2.2.0",
    "@node-rs/argon2": "2.2.1",
    "@phosphor-icons/react": "2.1.10",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "swr": "^2.5.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
