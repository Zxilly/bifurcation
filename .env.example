# Public origin; use HTTPS outside localhost.
BIFURCATION_PUBLIC_URL=http://localhost:3000
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key with your database backups. Do not generate a new key on restart.
BIFURCATION_APP_KEY=
BIFURCATION_PORT=3000
# Optional for local development; relative paths are resolved from apps/web.
# Compose stores the panel database in its /data persistent volume.
# BIFURCATION_DATABASE_PATH=./data/bifurcation.sqlite
# Optional local artifact directory containing daemon-linux-{amd64,arm64} and .sha256 files.
# The Docker image includes these artifacts and sets this path automatically.
# BIFURCATION_ARTIFACT_DIRECTORY=../../artifacts
